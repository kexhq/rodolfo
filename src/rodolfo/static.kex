# Files served from disk: the work behind +sendFile+ and +publicFolder+.
#
# Every reply here is one of Rodolfo's ordinary ones — the bytes as a
# +Response.Raw+, a 404 +Response.Text+ when there is no such file, a 304
# +Response.Empty+ when the browser's copy is still good — so a plug sees a
# served file the same way it sees any other route's reply.
#
# A file is read whole into memory before it is sent, which suits stylesheets,
# scripts, images, and fonts; it is not a way to stream a video.
module Rodolfo.Static

using Net.HTTP, only: [Headers, Request]
using Rodolfo.Response

# What serving a file can answer: the file, a 404, or a 304.
type Served = Rodolfo.Response.Raw | Rodolfo.Response.Text | Rodolfo.Response.Empty

# The +Content-Type+ a path's extension implies, or
# +application/octet-stream+ for one this table does not know. Text formats
# are sent as UTF-8. The extension is matched without regard to case.
#
# @param path [String] a file name or path; only its extension is read
# @return [String] the content type
#
# @example
#   Rodolfo.Static.mimeType("theme/site.css")   # => "text/css; charset=utf-8"
#   Rodolfo.Static.mimeType("LOGO.PNG")         # => "image/png"
#   Rodolfo.Static.mimeType("Makefile")         # => "application/octet-stream"
mimeType : String -> String
let mimeType(path) do
  mimeTypes().get(FS.Path.extension(path).lowerCase).or("application/octet-stream")
end

# Serves the one file at +path+, or a 404 when it is missing or is not a
# regular file.
#
# The path is the application's own choice, so nothing confines it — never
# build it from request input; that is what +within+ is for.
#
# @param request [Request<Binary>] the request being answered, for its
#   +If-None-Match+ and +If-Modified-Since+
# @param path [String] the file to send
# @param headers [Headers] sent with the file, a +Cache-Control+ for instance
# @return [Served] the file, a 404, or a 304
file : Request<Binary> -> String -> Headers -> Served
foul file(request, path, headers) do
  match FS.File.canonical(path) do
    Ok(real) => regular(request, real, mimeType(path), headers)
    Error(_) => missing()
  end
end

# Serves the file +relative+ names inside +directory+, or a 404 when it is
# missing, is not a regular file, or lies outside the directory.
#
# Both paths are resolved the way +realpath(3)+ does before they are
# compared, so neither a +..+ segment nor a symlink reaches a file outside
# +directory+. A symlink that stays inside it is followed.
#
# @param request [Request<Binary>] the request being answered
# @param directory [String] the directory files are served from
# @param relative [String] the requested path beneath it, untrusted
# @param headers [Headers] sent with the file, a +Cache-Control+ for instance
# @return [Served] the file, a 404, or a 304
within : Request<Binary> -> String -> String -> Headers -> Served
foul within(request, directory, relative, headers) do
  match contained(directory, relative) do
    Just(real) => regular(request, real, mimeType(relative), headers)
    None => missing()
  end
end

private do
  missing : Served
  let missing = Rodolfo.Response.Text { status: 404, body: "Not Found" }

  # The real path of +relative+ under +directory+, or +None+ when there is no
  # such path or it resolves to somewhere else. The comparison is on
  # canonical paths, so it is the filesystem's answer and not a guess made
  # from the spelling of the request.
  foul contained(directory: String, relative: String) -> String? do
    match (FS.File.canonical(directory), FS.File.canonical("${directory}/${relative}")) do
      (Ok(root), Ok(real)) => real.startsWith?(beneath(root)) then Just(real) else None
      _ => None
    end
  end

  # The prefix every path strictly inside +root+ starts with. The trailing
  # separator is what keeps +/srv/public-private+ out of +/srv/public+.
  let beneath(root: String) -> String = root.endsWith?("/") then root else "${root}/"

  foul regular(
    request: Request<Binary>,
    path: String,
    contentType: String,
    headers: Headers
  ) -> Served do
    match FS.File.info(path) do
      Ok(info) => do
        return missing() if info.kind != :file
        return answered(request, path, info, contentType, headers)
      end
      Error(_) => return missing()
    end
  end

  foul answered(
    request: Request<Binary>,
    path: String,
    info: FS.FileInfo,
    contentType: String,
    headers: Headers
  ) -> Served do
    let tag = entityTag(info)
    let stamp = httpDate(info.modified)
    let validated = defaulted(defaulted(headers, "ETag", tag), "Last-Modified", stamp)
    if unchanged?(request, tag, stamp)
      return Rodolfo.Response.Empty { status: 304, headers: validated }
    end
    match FS.File.readBytes(path) do
      Ok(bytes) => return Rodolfo.Response.Raw {
        body: bytes,
        contentType: contentType,
        headers: validated
      }
      Error(_) => return missing()
    end
  end

  # A header the caller set wins; ours only fills the gap.
  let defaulted(headers: Headers, name: String, value: String) -> Headers do
    match headers.get(name) do
      Just(_) => headers
      None => headers.add(name, value).or(headers)
    end
  end

  # Whether the browser's copy is still the file on disk. +If-None-Match+
  # decides when it is sent, and +If-Modified-Since+ is read only without it
  # (RFC 9110 §13.1.3) — compared as text against the +Last-Modified+ this
  # module sent, which is what a browser echoes back. Only a +GET+ or +HEAD+
  # is conditional.
  let unchanged?(request: Request<Binary>, tag: String, stamp: String) -> Bool do
    return false if request.method != "GET" && request.method != "HEAD"
    match request.headers.get("If-None-Match") do
      Just(sent) => sent.split(",").map { |candidate| candidate.trim }.any? { |candidate|
        candidate == "*" || opaque(candidate) == opaque(tag)
      }
      None => request.headers.get("If-Modified-Since") == Just(stamp)
    end
  end

  # An entity tag without its weakness marker: +If-None-Match+ compares
  # weakly, so +W/"a"+ and +"a"+ are the same tag.
  let opaque(tag: String) -> String = tag.startsWith?("W/") then tag.drop(2) else tag

  # Weak, because size and modification time to the second can miss an edit
  # that changes neither.
  let entityTag(info: FS.FileInfo) -> String = "W/\"${info.size}-${info.modified.epochSeconds}\""

  # An instant as HTTP writes one (RFC 9110 §5.6.7): +Sun, 06 Nov 1994
  # 08:49:37 GMT+. +FS.File.info+ reports modification times at UTC already.
  let httpDate(moment: DateTime) -> String do
    let date = moment.date
    let time = moment.time
    let day = "${date.weekday.name.take(3)}, ${padded(date.day)}"
    let clock = "${padded(time.hour)}:${padded(time.minute)}:${padded(time.second)}"
    "${day} ${monthName(date.month)} ${date.year} ${clock} GMT"
  end

  let padded(number: Integer) -> String = number < 10 then "0${number}" else "${number}"

  let monthName(month: Integer) -> String do
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    names.at(month - 1).or("Jan")
  end

  let mimeTypes -> Map<String, String> = {
    ".html": "text/html; charset=utf-8",
    ".htm": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".mjs": "text/javascript; charset=utf-8",
    ".json": "application/json",
    ".map": "application/json",
    ".webmanifest": "application/manifest+json",
    ".xml": "application/xml; charset=utf-8",
    ".txt": "text/plain; charset=utf-8",
    ".md": "text/markdown; charset=utf-8",
    ".csv": "text/csv; charset=utf-8",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".ico": "image/x-icon",
    ".woff2": "font/woff2",
    ".woff": "font/woff",
    ".ttf": "font/ttf",
    ".otf": "font/otf",
    ".pdf": "application/pdf",
    ".zip": "application/zip",
    ".gz": "application/gzip",
    ".wasm": "application/wasm",
    ".mp3": "audio/mpeg",
    ".wav": "audio/wav",
    ".ogg": "audio/ogg",
    ".mp4": "video/mp4",
    ".webm": "video/webm"
  }
end
