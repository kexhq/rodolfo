# A tiny Kemal- and Sinatra-inspired web framework built on Kex's HTTP server.
#
# A router is a block of HTTP verbs; nothing binds a socket until you +start+
# it:
#
# @example
#   using Rodolfo
#
#   main do
#     let site = Rodolfo.router do
#       get "/" do
#        "Hello from Kex!"
#       end
#
#       get "/hello/:name" do |env|
#         let name = env.param("name").or("world")
#         "Hello, ${name}!"
#       end
#     end
#
#     site.start(3000).try
#   end
#
# The reply records live in +Rodolfo.Response+ and the escaping in
# +Rodolfo.Markup+; both are re-exported here, so one `using Rodolfo` brings
# the whole DSL — the verbs, `Response.*`, and the ``html$`` and ``rawHTML$``
# tags.
module Rodolfo

# `Response` below is Rodolfo's own — the reply a route block returns — so
# Net.HTTP arrives selectively and its response constructors stay qualified.
# `Message`, `Text`, `BinaryMessage`, and `CloseMessage` stay unimported —
# `Text` collides with `Response.Text` — so a `ws` handler that pattern
# matches on messages brings them in itself: `using Net.HTTP.WebSocket, only:
# [Message, Text, BinaryMessage, CloseMessage]`.
using Net.HTTP, only: [Request, Context, Headers, Route, Server, ServerOptions]
using Net.HTTP.WebSocket, only: [WebSocket, Connection, Handshake, Upgrade, Accept, Reject]
using Net.Socket
using URI, only: [URI, Form]
using Rodolfo.Markup
using Rodolfo.Response

# Markup that is already escaped — see +Rodolfo.Markup+.
type Safe = Rodolfo.Markup.Safe

# Escapes the five characters that would end an element, an attribute, or the
# document. Re-exported from +Rodolfo.Markup+.
#
# @param text [String] the text to escape
# @return [String] the escaped text
escape : String -> String
let escape(text) = Rodolfo.Markup.escape(text)

# Vouches for a string as markup. Re-exported from +Rodolfo.Markup+.
#
# @param markup [String] text to treat as markup, escaping nothing
# @return [Safe] the string, trusted
safe : String -> Safe
let safe(markup) = Rodolfo.Markup.safe(markup)

# Concatenates rendered markup into one +Safe+. Re-exported from
# +Rodolfo.Markup+.
#
# @param pieces [[Safe]] the markup to join, in order
# @return [Safe] the pieces, concatenated
joined : [Safe] -> Safe
let joined(pieces) = Rodolfo.Markup.joined(pieces)

# The ``html$`` tag, escaping every hole. Re-exported from +Rodolfo.Markup+.
#
# @param parts [[String]] the literal's fixed text
# @param values [[Any]] the interpolated values
# @return [Safe] the assembled markup
#
# @example
#   html$`<p>${untrusted}</p>`
html : [String] -> [Any] -> Safe
let html(parts, values) = Rodolfo.Markup.html(parts, values)

# The ``rawHTML$`` tag, escaping nothing. Re-exported from +Rodolfo.Markup+.
#
# @param parts [[String]] the literal's fixed text
# @param values [[Any]] the interpolated values, inserted verbatim
# @return [Safe] the assembled markup, unescaped
#
# @example
#   rawHTML$`<style>${stylesheet}</style>`
rawHTML : [String] -> [Any] -> Safe
let rawHTML(parts, values) = Rodolfo.Markup.rawHTML(parts, values)

type Redirection = SeeOther | MovedPermanently | Found | Temporary | Permanent

# Redirects the browser to a new URL, with a 303 See Other status by default.
#
# Use the +redirectTo : String -> Redirection -> Response<Binary>+ if you want
# specify a different status code.
# @param location String the URL to send the browser to
# @return Response<Binary> the redirect response
#
# @example
#   get "/old" do
#     redirectTo("/new")   # redirect to /new, must be always returned from the route block
#   end
redirectTo : String -> Reply
let redirectTo(location) = redirectTo(location, SeeOther)

# Redirects the browser to a new URL, with a specific status code.
#
# Use the +redirectTo : String -> Response<Binary>+ for a simplified 303 See Other redirect.
# @param location String the URL to send the browser to
# @param redirection Redirection the status code to send, defaulting to 303 See Other (+SeeOther+)
# @return Response<Binary> the redirect response
#
# @example
#   get "/old" do
#     redirectTo("/new", MovedPermanently)   # redirect to /new, must be always returned from the route block
#   end
redirectTo : String -> Redirection -> Reply
let redirectTo(location, MovedPermanently) = Response.Redirect { status: 301, location }
let redirectTo(location, Found) = Response.Redirect { status: 302, location }
let redirectTo(location, SeeOther) = Response.Redirect { status: 303, location }
let redirectTo(location, Temporary) = Response.Redirect { status: 307, location }
let redirectTo(location, Permanent) = Response.Redirect { status: 308, location }

# The request context passed to route blocks.
#
# Declared here rather than in a submodule on purpose: the prelude also exports
# an +Context+ (+Mock.Context+), and a bare +Context+ in an application's annotation
# resolves to that one unless this record is declared in the module the
# application imports.
record Context do
  request : Request<Binary>
  context : Context
end

make Context do
  # Returns a named or wildcard route parameter.
  #
  # @param name [String] the +:name+ or wildcard from the route's path
  # @return [Result<String, NetError>] the captured text, or +Parse+
  #
  # @example
  #   get "/books/:id" do |env| env.param("id").try end
  param :> String -> Result<String, NetError>
  let param(name) = @context.route.parameter(name)

  # Returns a query-string field, or +None+ when the URL carries no such name.
  #
  # A browser submits a GET form as +application/x-www-form-urlencoded+, where
  # a space travels as `+` — so +?q=and+tools+ reads back as "and tools". That
  # is why this decodes the raw query rather than reading +target.query+, whose
  # RFC 3986 rules leave `+` as a literal plus.
  #
  # @param name [String] the field to read
  # @return [String?] its decoded value, or +None+
  #
  # @example
  #   let term = env.query("q").or("")
  query :> String -> String?
  let query(name) = field(queryFields(this), name)

  # Every query-string field, in the order the URL carries them.
  #
  # A field written without +=+ has no value.
  #
  # @return [[(String, String?)]] the decoded fields, in order
  queryFields :> [(String, String?)]
  let queryFields = decodedFields(queryText(@request.target.string))

  # Returns a field of an +application/x-www-form-urlencoded+ request body —
  # what an HTML form POSTs.
  #
  # @param name [String] the field to read
  # @return [String?] its decoded value, or +None+
  #
  # @example
  #   let title = env.form("title").or("")
  form :> String -> String?
  let form(name) = field(this.formFields, name)

  # Every submitted body field, in order.
  #
  # @return [[(String, String?)]] the decoded fields, in order
  formFields :> [(String, String?)]
  let formFields = decodedFields(@request.body.to(String).or(""))
end

# Everything a route block may return.
#
# +Safe+ is here because markup is a reply in its own right: returning an
# ``html$`...` `` literal from a route sends it as a 200 text/html page. A
# plain +String+ becomes a 200 text/plain body, which is what makes
# +do "hello" end+ a complete route.
type Reply = String
  | Rodolfo.Markup.Safe
  | Rodolfo.Response.JSON
  | Rodolfo.Response.Text
  | Rodolfo.Response.HTML
  | Rodolfo.Response.Raw
  | Rodolfo.Response.Empty
  | Rodolfo.Response.Redirect

# A route block: the request environment in, a reply out.
type Handler = Context -> Reply

# A composable request/response wrapper. A plug receives the handler it
# wraps (everything declared after it in its own scope, and every route
# beneath a nested scope) and returns a new handler around it.
#
# Halting a request is simply not calling the wrapped handler — there is no
# separate "stop" signal to thread through, and running code both before and
# after the wrapped handler (response headers, timing, translating an
# exception into a reply) is the same shape as running code only before or
# only after.
#
# A plug is written as a value (`let name = do |inner| ... end`), never as a
# named function passed by name or by `~` — both break for a curried
# function that returns another function, which is exactly `Plug`'s shape.
# Passed bare, `kex -C` accepts it but `kex -r` fails to build ("unbound
# variable"); passed as `~name`, it reaches the type checker with the wrong
# arity reconstructed for the reference. A closure literal sidesteps both —
# see docs/kex-issues.md #21.
#
# @example A plug that adds a header to every response it lets through
#   poweredBy : Plug
#   let poweredBy = do |inner|
#     do |env|
#       match inner(env) do
#         Response.Text { status, body, headers } =>
#           Response.Text { status: status, body: body, headers: headers.add("X-Powered-By", "Rodolfo").or(headers) }
#         reply => reply
#       end
#     end
#   end
#
# @example A plug that halts instead of calling the wrapped handler
#   blocked : Plug
#   let blocked = do |inner| do |env| Response.Text { status: 403, body: "forbidden" } end end
type Plug = Handler -> Handler

# One declaration in a Rodolfo route list.
record Definition do
  method : String
  path : String
  handler : Handler
end

# A WebSocket route block: the request environment the handshake arrived
# with (query string, headers, cookies — the same `Context` an ordinary
# route gets), and a live, already-upgraded connection to read from and
# write to. Everything before the upgrade — the handshake itself, and
# whether to accept it — is handled for you; see `ws`.
type SocketHandler = Context -> Connection -> Void

# One declaration for a `ws` route in a Rodolfo route list.
record WsDefinition do
  path : String
  handler : SocketHandler
end

# Wraps a `plug` declaration so it can sit in the same `router do ... end` or
# `scope do ... end` body as route declarations and nested scopes — see
# +Entry+.
record PlugEntry do
  wrapper : Plug
end

# A path-prefixed, plug-scoped group of declarations. Its own `plug`
# declarations apply to every route inside it, direct or nested, stacked
# after whatever scope contains it — see +scope+.
record Scope do
  prefix : String
  children : [Entry]
end

# One statement inside a `router do ... end` or `scope do ... end` body: a
# route, a WebSocket route, a plug, or a nested scope.
type Entry = Definition | WsDefinition | PlugEntry | Scope

# A flattened route: a scope tree collapses to one of these per
# `Definition`, its plug stack accumulated top-down and its path prefixed by
# every scope it sat inside — see `flattened`.
record Flat do
  method : String
  path : String
  plugs : [Plug]
  handler : Handler
end

# Declares a route for any HTTP method.
#
# The named verbs below cover the usual ones; reach for this when the method is
# unusual or computed.
#
# @param method [String] the HTTP method, uppercase
# @param path [String] the route path, with +:name+ captures
# @param handler [Handler] the route block
# @return [Entry] the declaration
#
# @example
#   route "PROPFIND", "/files" do Response.Empty {} end
route : String -> String -> Handler -> Entry
let route(method, path, handler) = Definition {
  method: method,
  path: path,
  handler: handler
}

# The same declaration, for a route block that ignores the request entirely
# — `Block<Reply>` (no `|_|`) rather than `Handler` (`|_|` mandatory).
route : String -> String -> Block<Reply> -> Entry
let route(method, path, block) = route(method, path, do |_| block() end)

# Declares a +GET+ route.
#
# @param path [String] the route path, with +:name+ captures
# @param handler [Handler] the route block
# @return [Entry] the declaration
#
# @example
#   get "/hello/:name" do |env| "Hello, ${env.param("name").try}!" end
get : String -> Handler -> Entry
let get(path, handler) = route("GET", path, handler)

get : String -> Block<Reply> -> Entry
let get(path, block) = route("GET", path, block)

# Declares a +POST+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
post : String -> Handler -> Entry
let post(path, handler) = route("POST", path, handler)

post : String -> Block<Reply> -> Entry
let post(path, block) = route("POST", path, block)

# Declares a +PUT+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
put : String -> Handler -> Entry
let put(path, handler) = route("PUT", path, handler)

put : String -> Block<Reply> -> Entry
let put(path, block) = route("PUT", path, block)

# Declares a +PATCH+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
patch : String -> Handler -> Entry
let patch(path, handler) = route("PATCH", path, handler)

patch : String -> Block<Reply> -> Entry
let patch(path, block) = route("PATCH", path, block)

# Declares a +DELETE+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
delete : String -> Handler -> Entry
let delete(path, handler) = route("DELETE", path, handler)

delete : String -> Block<Reply> -> Entry
let delete(path, block) = route("DELETE", path, block)

# Declares a +HEAD+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
head : String -> Handler -> Entry
let head(path, handler) = route("HEAD", path, handler)

head : String -> Block<Reply> -> Entry
let head(path, block) = route("HEAD", path, block)

# Declares an +OPTIONS+ route.
#
# @param path [String] the route path
# @param handler [Handler] the route block
# @return [Entry] the declaration
options : String -> Handler -> Entry
let options(path, handler) = route("OPTIONS", path, handler)

options : String -> Block<Reply> -> Entry
let options(path, block) = route("OPTIONS", path, block)

# Declares a WebSocket route: any client that completes the RFC 6455
# handshake at `path` is handed a live `Connection`, ready to `send` and
# `receiveMessage`. There is no subprotocol negotiation or handshake
# rejection here — every request that upgrades is accepted; reach for
# `Net.HTTP.WebSocket.upgrade` directly from an ordinary `get` route when you
# need that.
#
# WebSocket routes don't take part in the plug stack: a `Context -> Connection
# -> Void` handler isn't shaped like a `Handler`, and the upgrade handshake is
# a different lifecycle from an ordinary request/response. A path inside a
# `scope`, though, is prefixed exactly like any other route's.
#
# @param path [String] the route path, with +:name+ captures
# @param handler [SocketHandler] runs once per connection, for as long as it stays open
# @return [Entry] the declaration
#
# @example An echo server
#   ws "/echo" do |env, socket|
#     loop do
#       match socket.receiveMessage.try do
#         Text(text) => socket.send(Text(text)).try
#         CloseMessage(_, _) => break
#         _ => Void
#       end
#     end
#   end
#
# @example Rejecting a connection after the fact, since the handshake itself
#   always accepts — read the token, then close before doing anything else
#   ws "/chat" do |env, socket|
#     if env.query("token") == Just("let-me-in")
#       loop do ... end
#     else
#       socket.close
#     end
#   end
ws : String -> SocketHandler -> Entry
let ws(path, handler) = WsDefinition { path: path, handler: handler }

# Adds a plug to the enclosing `router do ... end` or `scope do ... end`
# body. Applies to every route declared in that body, direct or nested,
# regardless of whether the `plug` line comes before or after them —
# wrapping order among plugs in the same body follows their own declaration
# order, first-declared outermost.
#
# @param wrapper [Plug] the plug
# @return [Entry] the declaration
#
# @example
#   Rodolfo.router do
#     plug(Rodolfo.Plugs.errors())
#     get "/" do "hello" end
#   end
plug : Plug -> Entry
let plug(wrapper) = PlugEntry { wrapper: wrapper }

# Builders for `Plug` values.
module Plug do
  # Builds a `Plug` from a single two-argument block — the wrapped handler
  # and the request environment together — instead of the nested closure
  # form `do |inner| do |env| ... end end` a `Plug` is otherwise written as.
  # Still a closure literal either way, so #21's rule is unaffected: pass
  # `Plug.around` an inline block, never a named function referenced by `~`.
  #
  # @param body [Handler -> Context -> Reply] the wrapped handler and the
  #   request environment in, a reply out
  # @return [Plug] the plug
  #
  # @example A plug that adds a header to every response it lets through
  #   poweredBy : Rodolfo.Plug
  #   let poweredBy = Plug.around do |inner, env|
  #     match inner(env) do
  #       Response.Text { status, body, headers } =>
  #         Response.Text { status: status, body: body, headers: headers.add("X-Powered-By", "Rodolfo").or(headers) }
  #       reply => reply
  #     end
  #   end
  around : (Handler -> Context -> Reply) -> Rodolfo.Plug
  let around(body) = do |inner| do |env| body(inner, env) end end
end

# Groups declarations under a path prefix and, if it has any `plug` lines of
# its own, a plug stack that applies only inside the group — stacked after
# whatever scope contains it.
#
# @param prefix [String] prepended to every path declared inside, direct or nested
# @param entries [Block<[Entry]>] routes, plugs, and nested scopes
# @return [Entry] the declaration
#
# @example
#   Rodolfo.router do
#     scope "/api" do
#       plug(requireApiKey())
#       get "/books" do ... end
#     end
#   end
scope : String -> Block<[Entry]> -> Entry
let scope(prefix, entries) = Scope { prefix: prefix, children: entries() }

# A route list, ready to serve. Nothing is bound until you +start+ it.
record Router do
  entries : [Entry]
end

# Nests an already-built +Router+ under a path prefix, so a large
# application's routes can be declared as separate, independently testable
# routers and composed at the top rather than all written inline in one
# `router do ... end` body. Equivalent to `scope`, but the group's
# declarations were collected elsewhere instead of written at the call site.
#
# @param prefix [String] prepended to every path in `sub`, direct or nested
# @param sub [Router] the sub-router to nest
# @return [Entry] the declaration
#
# @example
#   let admin = Rodolfo.router do
#     get "/stats" do "42 requests" end
#   end
#
#   let api = Rodolfo.router do
#     mount("/admin", admin)
#     get "/" do "home" end
#   end
mount : String -> Router -> Entry
let mount(prefix, sub) = Scope { prefix: prefix, children: sub.entries }

# Collects a block of route, plug, and scope declarations into a router.
#
# Declaration order decides matches, so a fixed path goes before the capture
# that would also match it.
#
# @param entries [Block<[Entry]>] the route, plug, and scope declarations
# @return [Router] the collected routes
#
# @example
#   let api = Rodolfo.router do
#     get "/books/me" do "me" end
#     get "/books/:id" do |env| env.param("id").try end
#   end
router : Block<[Entry]> -> Router
let router(entries) = Router { entries: entries() }

make Router do
  # The Net.HTTP router these declarations compile to, for the rare caller
  # that wants to serve it by hand or mount it somewhere else.
  #
  # @return [Net.HTTP.Router] the compiled router
  httpRouter :> Net.HTTP.Router
  foul httpRouter = compileRoutes(@entries)

  # The compiled routes, in declaration order.
  #
  # @return [[Route]] the routes, as declared
  routes :> [Route]
  foul routes = this.httpRouter.routes

  # Combines two routers' declarations, unprefixed — `this`'s routes first.
  # Each side keeps its own plugs scoped to its own routes: they are not
  # flattened into one shared list, which would leak each side's plugs onto
  # the other's routes (an unprefixed `mount`, in effect). For nesting one
  # router under a path prefix instead, use +mount+.
  #
  # @param other [Router] the router to append
  # @return [Router] both routers' declarations, `this` first
  #
  # @example Combining routers built separately
  #   let combined = coreRoutes + adminRoutes + healthRoutes
  let +(other: This) -> This = Router {
    entries: [
      Scope { prefix: "", children: @entries },
      Scope { prefix: "", children: other.entries }
    ]
  }

  # Serves forever on loopback, on port 3000.
  #
  # @return [Result<Void, NetError>] never returns while serving
  start :> Result<Void, NetError>
  foul start do
    Server.serve(addressed("127.0.0.1", 3000).try, this.httpRouter)
  end

  # Serves forever on loopback, on the given port.
  #
  # Loopback is the default because a port bound on every interface is
  # reachable by every machine on the network, which is rarely what a program
  # under development means. Answering beyond this machine is the two-argument
  # form below, where the address is written out.
  #
  # @param port [Integer] the port to bind
  # @return [Result<Void, NetError>] never returns while serving
  start :> Integer -> Result<Void, NetError>
  foul start(port: Integer) do
    Server.serve(addressed("127.0.0.1", port).try, this.httpRouter)
  end

  # Serves forever on the given address.
  #
  # +"0.0.0.0"+ answers on every interface, one interface's address answers
  # only on that one, and a hostname is resolved. Port 0 asks the operating
  # system for a free port.
  #
  # @param host [String] the address or hostname to bind
  # @param port [Integer] the port to bind, or 0 for any free one
  # @return [Result<Void, NetError>] never returns while serving
  #
  # @example
  #   site.start("0.0.0.0", 3000).try     # reachable from the network
  #   site.start("127.0.0.1", 0).try      # this machine, OS picks the port
  start :> String -> Integer -> Result<Void, NetError>
  foul start(host: String, port: Integer) do
    Server.serve(addressed(host, port).try, this.httpRouter)
  end

  # Serves forever on the given address, with explicit server limits.
  #
  # @param host [String] the address or hostname to bind
  # @param port [Integer] the port to bind
  # @param options [ServerOptions] handler count, backlog, graceful shutdown
  # @return [Result<Void, NetError>] never returns while serving
  start :> String -> Integer -> ServerOptions -> Result<Void, NetError>
  foul start(host: String, port: Integer, options: ServerOptions) do
    Server.serve(addressed(host, port).try, this.httpRouter, options)
  end

  # Starts the router in the background on loopback and hands back a handle to
  # stop it — what specs and managed lifecycles want instead of a blocking
  # +start+.
  #
  # @param port [Integer] the port to bind, or 0 for any free one
  # @return [Result<Server.Running, NetError>] the running server
  #
  # @example Taking an ephemeral port in a spec
  #   let server = site.background(0).try
  #   let port = server.localAddress.port.value
  background :> Integer -> Result<Server.Running, NetError>
  foul background(port: Integer) do
    Server.start(addressed("127.0.0.1", port).try, this.httpRouter)
  end

  # Starts in the background on the given address.
  #
  # @param host [String] the address or hostname to bind
  # @param port [Integer] the port to bind, or 0 for any free one
  # @return [Result<Server.Running, NetError>] the running server
  background :> String -> Integer -> Result<Server.Running, NetError>
  foul background(host: String, port: Integer) do
    Server.start(addressed(host, port).try, this.httpRouter)
  end

  # Starts in the background on the given address, with explicit limits.
  #
  # @param host [String] the address or hostname to bind
  # @param port [Integer] the port to bind
  # @param options [ServerOptions] handler count, backlog, graceful shutdown
  # @return [Result<Server.Running, NetError>] the running server
  background :> String -> Integer -> ServerOptions -> Result<Server.Running, NetError>
  foul background(host: String, port: Integer, options: ServerOptions) do
    Server.start(addressed(host, port).try, this.httpRouter, options)
  end
end

private do
  # Everything after the first `?`, which is the whole query — only the first
  # one delimits, and a fragment never reaches a server.
  queryText : String -> String
  let queryText(target) = target.split("?").drop(1).join("?")

  decodedFields : String -> [(String, String?)]
  let decodedFields(text) = Form.parse(text).map { |form| form.entries }.or([])

  field : [(String, String?)] -> String -> String?
  let field(fields, name) do
    match fields.find { |entry| match entry do (key, _) => key == name end } do
      Just((_, value)) => value
      None => None
    end
  end

  # The port is validated here so a caller writes `start("0.0.0.0", 3000)`
  # rather than threading a `Net.Port` result of its own.
  foul addressed(host: String, port: Integer) -> Result<TCP.Endpoint, NetError> do
    Ok(TCP.Endpoint.host(host, Net.Port.from(port).try))
  end

  # Foul because the handlers it wraps serve requests, and a closure calling
  # foul code makes its enclosing context foul.
  compileRoutes : [Entry] -> Net.HTTP.Router
  foul compileRoutes(entries) = Net.HTTP.Router {
    routes: flattened(entries, "", []).map(~compileFlat) + wsFlattened(entries, "").map(~compileWs)
  }

  # Collapses a scope tree into one `Flat` per `Definition`.
  flattened : [Entry] -> String -> [Plug] -> [Flat]
  let flattened(entries, prefix, inherited) do
    let stack = inherited + plugsOf(entries)
    routesAndScopesOf(entries).flatMap { |entry|
      match entry do
        Definition { method, path, handler } =>
          [Flat { method: method, path: joinedPath(prefix, path), plugs: stack, handler: handler }]
        Scope { prefix: childPrefix, children } => flattened(children, joinedPath(prefix, childPrefix), stack)
        WsDefinition { path, handler } => []
      end
    }
  end

  # Collapses a scope tree into one `WsDefinition` per `ws` declaration, path
  # prefixed by every scope it sat inside. No plug stack: WebSocket routes
  # don't take part in it — see `ws`'s own doc comment.
  wsFlattened : [Entry] -> String -> [WsDefinition]
  let wsFlattened(entries, prefix) = routesAndScopesOf(entries).flatMap { |entry|
    match entry do
      WsDefinition { path, handler } => [WsDefinition { path: joinedPath(prefix, path), handler: handler }]
      Scope { prefix: childPrefix, children } => wsFlattened(children, joinedPath(prefix, childPrefix))
      Definition { method, path, handler } => []
    end
  }

  plugsOf : [Entry] -> [Plug]
  let plugsOf(entries) = entries.flatMap { |entry|
    match entry do
      PlugEntry { wrapper } => [wrapper]
      _ => []
    end
  }

  routesAndScopesOf : [Entry] -> [Entry]
  let routesAndScopesOf(entries) = entries.filter { |entry|
    match entry do
      PlugEntry { wrapper } => false
      _ => true
    end
  }

  # Joins a scope's prefix onto a path (or a scope's prefix onto its
  # enclosing scope's), tolerating either side's slash or lack of one.
  joinedPath : String -> String -> String
  let joinedPath(prefix, path) do
    let base = prefix.endsWith?("/") then prefix.take(prefix.length - 1) else prefix
    let rest = path.startsWith?("/") then path else "/${path}"
    let combined = "${base}${rest}"
    combined.empty? then "/" else combined
  end

  compileFlat : Flat -> Route
  foul compileFlat(Flat { method, path, plugs, handler: base }) = Route {
    method: method,
    path: path,
    handler: do |request, context|
      let handler = wrapped(plugs, base)
      respond(
        handler(Context { request: request, context: context }),
        "${method} ${path}"
      )
    end
  }

  # A `ws` route compiles to a plain GET: the RFC 6455 handshake a WebSocket
  # client sends is itself an ordinary GET request, and `WebSocket.upgrade`
  # is the part that recognizes it and answers with a 101 instead of calling
  # `handler` at all when the request isn't a valid handshake.
  compileWs : WsDefinition -> Route
  foul compileWs(WsDefinition { path, handler }) = Route {
    method: "GET",
    path: path,
    handler: do |request, context|
      let env = Context { request: request, context: context }
      WebSocket.upgrade(request, do |handshake| Accept(do |socket| handler(env, socket) end, Headers.empty, None) end)
    end
  }

  # Wraps `handler` with `plugs`, first-declared outermost: the first plug's
  # own code runs first (and, for an around-style plug, last) and the last
  # plug sits closest to `handler`.
  wrapped : [Plug] -> Handler -> Handler
  let wrapped([], handler) = handler
  let wrapped([p | rest], handler) = p(wrapped(rest, handler))

  # Turns whatever the route block returned into an HTTP response.
  #
  # A route is declared to return a +Reply+, but nothing stops a handler
  # from `.try`-ing its way to some other value (an escaped +Option+, for
  # instance) — see kexhq/rodolfo#7. Only a +String+ takes the plain-text
  # path; anything else is a bug in the application, logged and answered as
  # a 500 rather than silently served as 200 text. The final `Any` clause is
  # what catches that: every other clause matches one of +Reply+'s own
  # variants, so anything left over is not a +Reply+ at all.
  foul respond(reply: String, route: String) -> Net.HTTP.Response<Binary> = Net.HTTP.Response.text(200, reply)
  foul respond(Rodolfo.Markup.Safe { markup }, route: String) -> Net.HTTP.Response<Binary> = textual(200, markup, Headers.empty, "text/html; charset=utf-8")
  foul respond(Rodolfo.Response.JSON { status, body, headers }, route: String) -> Net.HTTP.Response<Binary> = textual(status, body, headers, "application/json")
  foul respond(Rodolfo.Response.Text { status, body, headers }, route: String) -> Net.HTTP.Response<Binary> = textual(status, body, headers, "text/plain; charset=utf-8")
  foul respond(Rodolfo.Response.HTML { status, body, headers }, route: String) -> Net.HTTP.Response<Binary> = textual(status, body, headers, "text/html; charset=utf-8")
  foul respond(Rodolfo.Response.Raw { status, body, headers, contentType }, route: String) -> Net.HTTP.Response<Binary> = Net.HTTP.Response.binary(status, body, typed(headers, contentType))
  foul respond(Rodolfo.Response.Empty { status, headers }, route: String) -> Net.HTTP.Response<Binary> = Net.HTTP.Response.binary(status, Binary.empty, headers)
  foul respond(Rodolfo.Response.Redirect { status, location, headers }, route: String) -> Net.HTTP.Response<Binary> = Net.HTTP.Response.binary(status, Binary.empty, appended(headers, "Location", location).try)
  foul respond(other: Any, route: String) -> Net.HTTP.Response<Binary> do
    IO.printError("Rodolfo: ${route} returned a value that is not a Reply: ${other}")
    Net.HTTP.Response.text(500, "Internal Server Error")
  end

  foul textual(status: Integer, body: String, headers: Headers, contentType: String) -> Net.HTTP.Response<Binary> do
    Net.HTTP.Response.binary(status, body.to(Binary).try, typed(headers, contentType))
  end

  # A reply's own `Content-Type` wins; the record's kind only fills the gap.
  foul typed(headers: Headers, contentType: String) -> Headers do
    match headers.get("Content-Type") do
      Just(_) => headers
      None => appended(headers, "Content-Type", contentType).try
    end
  end

  # Appends one field, validating the whole collection. Building it in one
  # `Headers.from` rather than chaining is what rejects a name or value
  # carrying a line break, instead of writing an injectable message.
  appended : Headers -> String -> String -> Result<Headers, NetError>
  let appended(headers, name, value) = Headers.from([...headers.entries, (name, value)])
end
