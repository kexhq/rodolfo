# Rodolfo example: a complete book-management interface — list, search, add,
# edit, delete, lend, and return — served as plain HTML forms.
#
#   tey install && tey run     # http://localhost:3000/books
#
# Three environment variables move it: PORT changes the port, HOST opens it up
# to the network (it answers on this machine alone by default), and
# LIBRARY_FILE moves the catalogue file.
#
#   HOST=0.0.0.0 tey run       # reachable from a phone on the same network
#
# Five files divide the work: `catalog.kex` holds the books and the rules about
# them (pure), `mock_data.kex` is the catalogue a fresh install starts from,
# `shelf.kex` keeps them in a file between requests, `views.kex` renders
# escaped HTML, and this file maps HTTP onto the rest.
using Rodolfo
using Catalog, only: [Book, Draft]
using MockData

# Answers a form submission by sending the browser somewhere to GET, so a
# reload never repeats the change.
let seeOther(location: String) -> Rodolfo.Reply do
  Response.Redirect { status: 303, location: location }
end

# Renders a book that may not exist, with one 404 page for every route.
let withBook(book: Book?, render: Book -> Rodolfo.Reply) -> Rodolfo.Reply do
  match book do
    Just(found) => render(found)
    None => Response.HTML { status: 404, body: "${Views.missing("No book carries that id.")}" }
  end
end

# The `:id` in the path, or 0 — an id the shelf never issues, so an unparsable
# path lands on the same 404 page as a deleted book.
let bookId(env: Env) -> Integer do
  env.param("id").or("").trim.to(Integer).or(0)
end

# The submitted fields of the form body. A missing field reads as empty, which
# is what `Catalog.validate` rejects.
let submitted(env: Env) -> Draft do
  Draft {
    title: env.form("title").or(""),
    author: env.form("author").or(""),
    year: env.form("year").or("")
  }
end

# One query-string value, or "".
let queried(env: Env, name: String) -> String do
  env.query(name).or("")
end

# The message a redirect asked the next page to show. Routes pass a code, so
# `?notice=` cannot smuggle prose of its own onto the page.
let notice(env: Env) -> String? do
  Views.noticeText(queried(env, "notice"))
end

main do
  let stocked = Shelf.opened(MockData.books)
  let port = ENV.get("PORT").flatMap { |text| text.to(Integer) }.or(3000)
  # This machine alone unless HOST says otherwise: the catalogue can be edited
  # and deleted without signing in, so opening it to the network is a decision
  # to make on purpose rather than a default to discover.
  let bindHost = ENV.get("HOST").or("127.0.0.1")
  IO.printLine("Rodolfo Library: ${stocked.count} books in ${Shelf.catalogueFile}")
  # The wildcard bind answers on every address, so the name to print is the one
  # a person would type; any other HOST is the only address that answers, and
  # saying "localhost" there would name a URL that refuses the connection.
  if bindHost == "0.0.0.0"
    IO.printLine("Listening on http://localhost:${port}/books")
    IO.printLine("On this network: http://<this machine>:${port}/books")
    IO.printLine("  address: `ipconfig getifaddr en0` (macOS), `hostname -I` (Linux)")
  elif bindHost == "127.0.0.1"
    IO.printLine("Listening on http://localhost:${port}/books")
    IO.printLine("This machine only; HOST=0.0.0.0 opens it to the network.")
  else
    IO.printLine("Listening on http://${bindHost}:${port}/books")
  end

  # Declaration order decides matches, so `/books/new` is declared before
  # `/books/:id` — otherwise "new" would be read as an id.
  let library = Rodolfo.router do
    get "/" do |_|
      seeOther("/books")
    end

    get "/books" do |env|
      let term = queried(env, "q")
      Views.index(Shelf.matching(term), term, notice(env))
    end

    get "/books/new" do |_|
      Views.form("Add a book", "/books", Draft {}, [])
    end

    post "/books" do |env|
      let draft = submitted(env)
      match Catalog.validate(draft) do
        [] => do
          let id = Shelf.filed(draft)
          seeOther("/books/${id}?notice=created")
        end
        errors => Response.HTML {
          status: 422,
          body: "${Views.form("Add a book", "/books", draft, errors)}"
        }
      end
    end

    get "/books/:id" do |env|
      withBook(Shelf.find(bookId(env))) do |book|
        Views.show(book, notice(env))
      end
    end

    get "/books/:id/edit" do |env|
      withBook(Shelf.find(bookId(env))) do |book|
        Views.form("Edit this book", "/books/${book.id}", Catalog.drafted(book), [])
      end
    end

    # Browsers only send GET and POST from a form, so editing posts to the
    # book's own path. `DELETE /books/:id` below serves the same catalogue to
    # a client that can send any method.
    post "/books/:id" do |env|
      let id = bookId(env)
      let draft = submitted(env)
      match Catalog.validate(draft) do
        [] => withBook(Shelf.rewritten(id, draft)) do |book|
          seeOther("/books/${book.id}?notice=updated")
        end
        errors => withBook(Shelf.find(id)) do |book|
          Response.HTML {
            status: 422,
            body: "${Views.form("Edit this book", "/books/${book.id}", draft, errors)}"
          }
        end
      end
    end

    post "/books/:id/delete" do |env|
      match Shelf.dropped(bookId(env)) do
        true => seeOther("/books?notice=deleted")
        false => Response.HTML {
          status: 404,
          body: "${Views.missing("No book carries that id.")}"
        }
      end
    end

    # Lending either way sends the reader back to the catalogue rather than to
    # the book they just handled, so the next thing on screen is the shelf.
    post "/books/:id/borrow" do |env|
      withBook(Shelf.lent(bookId(env), true)) do |_|
        seeOther("/books?notice=lent")
      end
    end

    post "/books/:id/return" do |env|
      withBook(Shelf.lent(bookId(env), false)) do |_|
        seeOther("/books?notice=returned")
      end
    end

    # The same delete for `curl -X DELETE`: no page to render, so 204.
    delete "/books/:id" do |env|
      match Shelf.dropped(bookId(env)) do
        true => Response.Empty {}
        false => Response.Empty { status: 404 }
      end
    end
  end

  library.start(bindHost, port).try
end
