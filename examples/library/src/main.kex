# Rodolfo example: a complete book-management interface — list, search, add,
# edit, delete, lend, and return — served as plain HTML forms.
#
#   tey install && tey run     # http://localhost:3000/books
#
# Three environment variables move it: PORT changes the port, HOST opens it up
# to the network (it answers on this machine alone by default), and
# LIBRARY_FILE moves the catalogue file.
#
#   HOST=0.0.0.0 tey run       # reachable from a phone on the same network
#
# Six modules divide the work: `catalog/` holds the books and the rules
# about them (pure), `mock_data.kex` is the catalogue a fresh install starts
# from, `shelf.kex` is a `serving` process that holds them between requests
# (backed by a file, so a restart doesn't lose the catalogue), `library/views.kex`
# (module `Library.Views` — namespaced so it doesn't collide with another
# example's own `Views` module in the same `tey` workspace) renders escaped
# HTML, `library/site.kex` (module `Library.Site`) maps HTTP onto the rest,
# and this file starts it.
using MockData

main do
  let shelf = Shelf.opened(MockData.MOCK_BOOKS)
  let port = ENV.get("PORT").into { |text| text.to(Integer) }.or(3000)
  let bindHost = ENV.get("HOST").or("127.0.0.1")
  IO.printLine("Rodolfo Library: ${shelf.matching("").try.count} books in ${Shelf.catalogueFile}")
  if bindHost == "0.0.0.0"
    IO.printLine("Listening on http://localhost:${port}/books")
    IO.printLine("On this network: http://<this machine>:${port}/books")
    IO.printLine("  address: `ipconfig getifaddr en0` (macOS), `hostname -I` (Linux)")
  elif bindHost == "127.0.0.1" || bindHost == "localhost"
    IO.printLine("Listening on http://localhost:${port}/books")
    IO.printLine("This machine only; HOST=0.0.0.0 opens it to the network.")
  else
    IO.printLine("Listening on http://${bindHost}:${port}/books")
  end

  Library.Site.site(shelf).start(bindHost, port).try
end
