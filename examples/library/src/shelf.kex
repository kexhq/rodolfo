# Where the catalogue lives between requests: one tab-separated file, read
# before a change and written after it. Every rule about the books stays in
# `catalog/`; this module only moves them to and from the disk.
#
# A `serving` process would be the natural home for shared state, and this
# example started there — but Kex 0.4.0-beta does not export a program's slot
# functions once that program depends on `Net.HTTP`, so a Rodolfo app cannot
# call its own slots yet. A file is the next simplest store, and it outlasts
# the server. Two writes that overlap can lose one of the changes, which a
# one-reader catalogue never notices and a busy one would.
module Shelf

using Catalog.Book, only: [Book, BookId]
using Catalog.Books, only: [decoded]
using Catalog.Draft, only: [Draft]

# The catalogue file. `LIBRARY_FILE` moves it, so two servers can run side by
# side and a spec can point at a scratch copy.
catalogueFile : String
foul catalogueFile = ENV.get("LIBRARY_FILE").or("books.tsv")

# Writes the opening catalogue, unless there is one already. Returns the books
# on the shelf either way.
opened : [Draft] -> [Book]
foul opened(drafts) do
  let fresh? = FS.File.exists?(catalogueFile).falsy?
  fresh? then stocked(drafts) else books
end

# Every book, newest first.
books : [Book]
foul books = decoded(FS.File.read(catalogueFile).or("")).sorted

# The books matching a search term; every book when the term is empty.
matching : String -> [Book]
foul matching(term) = decoded(FS.File.read(catalogueFile).or("")).matching(term)

# One book, or `None` when no book carries that id.
find : BookId -> Book?
foul find(id) = books.carrying(id)

# Files a validated draft and returns the id it was given.
filed : Draft -> BookId
foul filed(draft) do
  let current = books
  let id = current.nextId
  kept(current.added(id, draft))
  id
end

# Rewrites a book from a validated draft, returning the stored result, or
# `None` when the id is unknown.
rewritten : BookId -> Draft -> Book?
foul rewritten(id, draft) do
  let current = books.edited(id, draft)
  kept(current)
  current.carrying(id)
end

# Removes a book, returning whether there was one to remove.
dropped : BookId -> Bool
foul dropped(id) do
  let current = books
  kept(current.without(id))
  current.carrying(id).set?
end

# Lends a book out or takes it back, returning the stored book.
lent : BookId -> Bool -> Book?
foul lent(id, borrowed?) do
  let current = books.lending(id, borrowed?)
  kept(current)
  current.carrying(id)
end

# Replaces the catalogue file with `books`.
kept? : [Book] -> Bool
foul kept(books) = FS.File.write(catalogueFile, books.encoded)

# Writes a catalogue built from `drafts`, numbering them from one.
stocked : [Draft] -> [Book]
foul stocked(drafts) do
  let seeded = drafts.reduce([]) { |shelved, draft| shelved.added(shelved.nextId, draft) }
  kept(seeded)
  seeded.sorted
end
