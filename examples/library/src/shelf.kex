# Where the catalogue lives between requests: a `serving` process holding the
# books in memory, backed by one tab-separated file so the catalogue outlasts
# the server. Every rule about the books stays in `catalog/`; this module only
# moves them to and from the process and the disk.
#
# A `serving` process is the natural home for shared state, but Kex
# 0.4.0-beta didn't export a program's slot functions once the program also
# depended on `Net.HTTP` and the `serving` block sat in anything but the
# entrypoint module (kexhq/kex#376/#377), so this started as a plain file: a
# read before every change, a write after it. That workaround is gone now
# that #377 and its follow-on gaps (kexhq/kex#384, and a `Server<T>` module-
# prefix bug found chasing it) are fixed — the process also buys what the
# file alone couldn't: two changes that overlap can no longer lose one of
# them, since they're serialized through the one process that owns the
# state, not raced against the disk directly.
module Shelf

using Catalog.Book, only: [Book, BookId]
using Catalog.Books, only: [decoded]
using Catalog.Draft, only: [Draft]

# The catalogue file. `LIBRARY_FILE` moves it, so two servers can run side by
# side and a spec can point at a scratch copy.
catalogueFile : String
foul catalogueFile = ENV.get("LIBRARY_FILE").or("books.tsv")

record Catalogue do
  books : [Book] = []
end

serving Catalogue do
  # The books matching a search term; every book when the term is empty, so
  # `matching("")` doubles as "every book, newest first" — every call site
  # here already takes a real argument regardless.
  slot matching(term: String) -> Reply<[Book]> = { reply: @books.matching(term) }

  # One book, or `None` when no book carries that id.
  slot find(id: BookId) -> Reply<Book?> = { reply: @books.carrying(id) }

  # Files a validated draft and returns the id it was given.
  foul slot filed(draft: Draft) -> Reply<BookId> do
    let id = @books.nextId
    new.books = @books.added(id, draft)
    persisted(new.books)
    return { new, reply: id }
  end

  # Rewrites a book from a validated draft, returning the stored result, or
  # `None` when the id is unknown.
  foul slot rewritten(id: BookId, draft: Draft) -> Reply<Book?> do
    new.books = @books.edited(id, draft)
    persisted(new.books)
    return { new, reply: new.books.carrying(id) }
  end

  # Removes a book, returning whether there was one to remove.
  foul slot dropped(id: BookId) -> Reply<Bool> do
    let existed = @books.carrying(id).set?
    new.books = @books.without(id)
    persisted(new.books)
    return { new, reply: existed }
  end

  # Lends a book out or takes it back, returning the stored book.
  foul slot lent(id: BookId, borrowed?: Bool) -> Reply<Book?> do
    new.books = @books.lending(id, borrowed?)
    persisted(new.books)
    return { new, reply: new.books.carrying(id) }
  end
end

# Spawns the shelf, seeded from the catalogue file if there is one, or from
# `drafts` (and a fresh file written from them) if there isn't.
opened : [Draft] -> Server<Catalogue>
foul opened(drafts) do
  let fresh? = FS.File.exists?(catalogueFile).falsy?
  let initial = fresh? then stocked(drafts) else decoded(FS.File.read(catalogueFile).or("")).sorted
  Process.spawn(Catalogue { books: initial })
end

private do
  # Replaces the catalogue file with `books`.
  persisted : [Book] -> Bool
  foul persisted(books) = FS.File.write(catalogueFile, books.encoded)

  # A catalogue built from `drafts`, numbered from one and written to disk.
  stocked : [Draft] -> [Book]
  foul stocked(drafts) do
    let seeded = drafts.reduce([]) { |shelved, draft| shelved.added(shelved.nextId, draft) }
    persisted(seeded)
    seeded.sorted
  end
end
