# One book: the record the shelf stores, and what a single book knows how to
# do — turn itself back into a draft, answer a search, and render itself as
# one line of the catalogue file. The rules about many books live in
# `books.kex`; the rules about untrusted form input live in `draft.kex`.
module Catalog.Book

using Catalog.Draft, only: [Draft]

# The identifier the shelf gives a book: an integer in the file and in the
# URLs, but its own name in the code, so it is never confused with a year or
# a count.
distinct type BookId = Integer

# One catalogue entry. `id` is assigned by the shelf, never by a request.
record Book do
  id : BookId
  title : String
  author : String
  year : Integer
  borrowed? : Bool = false
end

# The catalogue's order: newest first, and books of one year by title. Living
# on the record rather than in a comparator means a plain `.sort` produces it.
make Book, implement: Comparable do
  let compare(other: Book) -> Ordering do
    other.year.compare(@year).thenBy { @title.compare(other.title) }
  end

  # The draft an edit form starts from.
  drafted :> Draft
  let drafted = Draft {
    title: @title,
    author: @author,
    year: "${@year}"
  }

  # Whether `term` occurs in the title or the author, case-insensitively. An
  # empty term matches, so the search box needs no special case.
  matches? :> String -> Bool
  let matches?(term) do
    let query = term.trim.lowerCase
    query.empty? || @title.lowerCase.contains?(query) || @author.lowerCase.contains?(query)
  end

  # The book as one line of the catalogue file: five tab-separated fields.
  asLine :> String
  let asLine do
    let lent = @borrowed? then "1" else "0"
    ["${@id}", oneLine(@title), oneLine(@author), "${@year}", lent].join("\t")
  end

  private do
    # `text` with the two characters the catalogue format reserves replaced,
    # so a title can never split a record in two.
    oneLine :> String -> String
    let oneLine(text) = text.replace("\t", " ").replace("\r", " ").replace("\n", " ")
  end
end
