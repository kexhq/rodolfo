# Every page the library serves, rendered from the `.ket` templates beside
# this file. `Kex.embed` reads each one at compile time and `Template.html`
# compiles it into a function of its `params`, so the markup is checked with
# the rest of the program and costs no file read at run time.
#
# `Template.html` escapes every `<%= %>` hole, so a book title can never
# become markup. `<%== %>` is raw, and is used only for what a template here
# already rendered: the layout's page, a partial, the stylesheet. Each page is
# handed back as Rodolfo's `Safe`, which a route replies with as HTML as-is.
module Library.Views

using Catalog.Book, only: [Book]
using Catalog.Draft, only: [Draft]
using Rodolfo, only: [Safe, safe]

# The shell every page shares: title, stylesheet, header, and the page.
let layout = Template.html(Kex.embed("layout.html.ket"))
let indexPage = Template.html(Kex.embed("index.html.ket"))
let showPage = Template.html(Kex.embed("show.html.ket"))
let formPage = Template.html(Kex.embed("form.html.ket"))
let missingPage = Template.html(Kex.embed("missing.html.ket"))
let rowPartial = Template.html(Kex.embed("_row.html.ket"))
let statusPartial = Template.html(Kex.embed("_status.html.ket"))
let actionsPartial = Template.html(Kex.embed("_actions.html.ket"))
let noticePartial = Template.html(Kex.embed("_notice.html.ket"))

stylesheet : String
let stylesheet = Kex.embed("library.css")

# The catalogue: a search box, a count, and one row per book.
index : [Book] -> String -> String? -> Safe
let index(books, term, notice) do
  let rows = books.map { |book| rowPartial(book, statusPartial(book), actionsPartial(book)) }.join("")
  page("Catalogue") do
    indexPage(noticePartial(notice.or("")), term, summary(books, term), rows, emptyMessage(term))
  end
end

# One book on its own page, with everything that can be done to it.
show : Book -> String? -> Safe
let show(book, notice) do
  page(book.title) do
    showPage(book, noticePartial(notice.or("")), statusPartial(book), actionsPartial(book))
  end
end

# The new-book and edit-book form. `errors` is empty on a first visit and
# carries `Catalog.validate`'s messages when a submission comes back.
form : String -> String -> Draft -> [String] -> Safe
let form(heading, action, draft, errors) do
  page(heading) { formPage(heading, action, draft, errors) }
end

# The 404 page, also used when a path carries an id no book has.
missing : String -> Safe
let missing(what) = page("Not found") { missingPage(what) }

# The one-line message a redirect asks the next page to show. Routes send a
# code rather than prose, so a hand-edited URL cannot inject a message.
noticeText : String -> String?
let noticeText(code) do
  match code do
    "created" => Just("Book added.")
    "updated" => Just("Changes saved.")
    "deleted" => Just("Book removed.")
    "lent" => Just("Book marked as on loan.")
    "returned" => Just("Book back on the shelf.")
    _ => None
  end
end

private do
  page : String -> Block<String> -> Safe
  let page(title, content) = safe(layout(title, stylesheet) { content() })

  emptyMessage : String -> String
  let emptyMessage(term) do
    term.trim.empty? then "The catalogue is empty. Add the first book." else "No book matches that search."
  end

  summary : [Book] -> String -> String
  let summary(books, term) do
    let counted = books.count == 1 then "1 book" else "${books.count} books"
    let scope = term.trim.empty? then "" else " matching “${term.trim}”"
    "${counted}${scope}, ${books.count { |book| book.borrowed? }} on loan"
  end
end
