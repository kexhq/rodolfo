# The shelf is the only part of the example that touches the disk, so every
# case here points `LIBRARY_FILE` at its own scratch file and starts from an
# empty one. Nothing is shared between cases, and nothing is left behind.
using Catalog.Book, only: [BookId]
using Catalog.Draft, only: [Draft]

# Points the shelf at an empty scratch file named after the case using it.
foul scratch(name: String) -> String do
  let path = FS.Path.join(FS.Directory.temporary, "rodolfo-library-${name}.tsv")
  ENV.set("LIBRARY_FILE", path)
  FS.File.exists?(path) then FS.File.delete(path) else true
  path
end

let draft(title: String, author: String, year: String) -> Draft do
  Draft { title: title, author: author, year: year }
end

let dune() -> Draft do
  draft("Dune", "Frank Herbert", "1965")
end

describe("Shelf.opened") do
  it("writes the opening catalogue when there is no file yet") do
    let path = scratch("opened")
    let shelf = Shelf.opened([dune(), draft("Emma", "Jane Austen", "1815")])
    assert(shelf.matching("").try.count == 2)
    assert(FS.File.exists?(path))
  end

  it("leaves an existing catalogue alone") do
    scratch("reopened")
    let first = Shelf.opened([dune()])
    first.filed(draft("Emma", "Jane Austen", "1815")).try
    let reopened = Shelf.opened([dune()])
    assert(reopened.matching("").try.count == 2)
  end
end

describe("Shelf.filed") do
  it("returns the id it gave the book and stores it") do
    scratch("filed")
    let shelf = Shelf.opened([])
    let id = shelf.filed(dune()).try
    assert(id == 1)
    assert(shelf.find(id).try.map { |book| book.title } == Just("Dune"))
  end

  it("counts past the highest id in use, not past the shelf's length") do
    scratch("filed-again")
    let shelf = Shelf.opened([])
    let first = shelf.filed(dune()).try
    shelf.filed(draft("Emma", "Jane Austen", "1815")).try
    shelf.dropped(first).try
    assert(shelf.filed(draft("Ancillary Justice", "Ann Leckie", "2013")).try == 3)
  end
end

# No separate `Shelf.books` slot — `matching("")` doubles as "every book,
# newest first".
describe("Shelf.matching") do
  it("reads an absent file as an empty catalogue") do
    scratch("absent")
    let shelf = Shelf.opened([])
    assert(shelf.matching("").try == [])
  end

  it("returns the newest book first for an empty term") do
    scratch("ordered")
    let shelf = Shelf.opened([])
    shelf.filed(dune()).try
    shelf.filed(draft("Ancillary Justice", "Ann Leckie", "2013")).try
    assert(shelf.matching("").try.map { |book| book.year } == [2013, 1965])
  end

  it("searches the stored catalogue") do
    scratch("matching")
    let shelf = Shelf.opened([])
    shelf.filed(dune()).try
    shelf.filed(draft("Emma", "Jane Austen", "1815")).try
    assert(shelf.matching("austen").try.map { |book| book.title } == ["Emma"])
    assert(shelf.matching("").try.count == 2)
  end
end

describe("Shelf.rewritten") do
  it("stores the change and returns the stored book") do
    scratch("rewritten")
    let shelf = Shelf.opened([])
    let id = shelf.filed(dune()).try
    let saved = shelf.rewritten(id, draft("Dune Messiah", "Frank Herbert", "1969")).try
    assert(saved.map { |book| book.title } == Just("Dune Messiah"))
    assert(shelf.find(id).try.map { |book| book.year } == Just(1969))
  end

  it("returns None for an unknown id and changes nothing") do
    scratch("rewritten-unknown")
    let shelf = Shelf.opened([])
    shelf.filed(dune()).try
    assert(shelf.rewritten(99.as(BookId), draft("X", "Y", "2000")).try.none?)
    assert(shelf.matching("").try.count == 1)
  end
end

describe("Shelf.dropped") do
  it("removes the book and says it was there") do
    scratch("dropped")
    let shelf = Shelf.opened([])
    let id = shelf.filed(dune()).try
    assert(shelf.dropped(id).try)
    assert(shelf.matching("").try == [])
  end

  it("says nothing was there for an unknown id") do
    scratch("dropped-unknown")
    let shelf = Shelf.opened([])
    assert(shelf.dropped(99.as(BookId)).try.falsy?)
  end
end

describe("Shelf.lent") do
  it("lends a book out and takes it back") do
    scratch("lent")
    let shelf = Shelf.opened([])
    let id = shelf.filed(dune()).try
    assert(shelf.lent(id, true).try.map { |book| book.borrowed? } == Just(true))
    assert(shelf.find(id).try.map { |book| book.borrowed? } == Just(true))
    assert(shelf.lent(id, false).try.map { |book| book.borrowed? } == Just(false))
  end

  it("returns None for an unknown id") do
    scratch("lent-unknown")
    let shelf = Shelf.opened([])
    assert(shelf.lent(99.as(BookId), true).try.none?)
  end
end
