# The perf-focused sibling of `examples/chat`: same login form, same wire
# spirit, but built to stay fast as the room grows. A workspace member like
# every other example, resolving Rodolfo from this checkout.
package "chat_perf" do
  version("0.1.0")
  description("Rodolfo example: a scalable broadcast WebSocket chat room")
  kex(">= 0.4.0-beta.3")
  license("MIT")

  entrypoint("src/main.kex")

  command("test:browser", run: "tey test spec/browser/chat_perf.spec.kex", description: "Run the browser specs in a headless Chrome")
  command("test:watch", run: "SHAKESPEARE_WATCH=1 tey test spec/browser/chat_perf.spec.kex", description: "Run the browser specs in a visible Chrome, paced, to watch them")

  tey("rodolfo", workspace: true)

  group :browser do
    tey("shakespeare", path: "../../../shakespeare-kexmain")
  end
end
