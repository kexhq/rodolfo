# A broadcast chat room over a single `ws` route, with a shared room
# password and a per-connection display name — both passed as query
# parameters on the WebSocket URL, since a handshake can't carry anything
# else and Rodolfo's `ws` always accepts the upgrade itself; closing right
# away is how a `ws` route rejects a connection after the fact.
#
# Run this, then open http://localhost:3000/ in two or more browser tabs (or
# two different browsers) — enter "let-me-in" as the room password and a
# different name in each, and chat between them. The two pages themselves
# live in `chat/views.kex` — see there for how they're built.
#
# `Room` is declared right here in the entrypoint module on purpose — a
# `serving` process whose slots are called from a route handler only works
# reliably when the `serving` block sits in the entrypoint, not an imported
# module (see docs/kex-issues.md #1/#2 in the main Rodolfo checkout).
# kexhq/kex#377 fixed the shape that entry covers, but not reliably enough to
# move `Room` out yet — re-tried 2026-09-20 (extracted to its own
# `Chat.Room` module) and reverted: with `Net.HTTP` in the build, a
# `serving` process in an imported module still fails its first call some of
# the time, in more than one shape (see docs/kex-issues.md #2's own update).
using Rodolfo
using Net.HTTP.WebSocket, only: [Message, Text, BinaryMessage, CloseMessage]
using Chat.Views
using Chat.Protocol

# Deliberately simple: one shared password for the whole room, checked
# against a query parameter on both the login page and the WebSocket URL
# itself. Real auth would exchange this for a signed session; this is only
# meant to show `ws` reading the request it was upgraded from.
roomToken : String
let roomToken = "let-me-in"

# Every connection, by name — a name doubles as the room's idea of "who's
# here", so `join` can refuse a name already in use and the client can be
# shown a live roster, not just a scrolling log. `broadcast` doubles as the
# only place a dead connection gets noticed: a socket whose `send` fails —
# the peer closed without a clean handshake, most likely — is dropped from
# the room rather than tracked down by a separate message.
#
# A `Map`, not a list of pairs: `taken?`/`join` no longer scan every
# connection to find a name, `leave` no longer has to filter it out by hand.
# The one thing this trades away is roster order — a `Map`'s `keys` come back
# in canonical key order (alphabetical, here), not insertion order, so the
# roster sorts by name rather than showing whoever joined most recently
# first. Nothing downstream (`chat.js`'s `updateRoster`, the specs) assumes
# an order, so this is a pure win.
record Room do
  users : {String: Connection} = {}
end

serving Room do
  # Checked from the login page itself, before ever reaching `/chat` — a
  # nicer failure than "you connected, then got kicked off" for the common
  # case. `join` re-checks (and is the one that actually matters): a second
  # connection could pick the same name in the gap between this check and
  # the next request, and only `join` runs atomically with the join itself.
  slot taken?(name: String) -> Reply<Bool> do
    return { reply: @users.has?(name) }
  end

  # `None` means the name is already taken and nothing changed; `Just`
  # carries the roster (every name, this one included) to announce.
  slot join(name: String, socket: Connection) -> Reply<[String]?> do
    if @users.has?(name)
      return { reply: None }
    else
      new.users = @users.put(name, socket)
      return { new, reply: Just(new.users.keys) }
    end
  end

  # The roster after removal, to announce the same way `join` does.
  slot leave(name: String) -> Reply<[String]> do
    new.users = @users.delete(name)
    return { new, reply: new.users.keys }
  end

  slot broadcast(text: String) -> Void do
    new.users = @users.filter { |_, socket| socket.send(Text(text)).ok? }
    return new
  end
end

main do
  let room = Process.spawn(Room {})

  let site = Rodolfo.router do
    get "/" do |env|
      let token = env.query("token").or("")
      let name = env.query("name").or("").trim
      # Whether the form was submitted at all, not whether either field came
      # back non-empty — an empty submission (both fields blank) still sets
      # `token=&name=` on the query string, present but empty, which is
      # exactly the case that needs the error shown rather than treated
      # like a first visit with no query string at all.
      let attempted = env.query("token").set? || env.query("name").set?
      let validCredentials = !token.empty? && token == roomToken && !name.empty?
      if validCredentials && !room.taken?(name).try
        # `URI.Form` fully qualified, with no `using URI` above: importing
        # `URI` makes the run stage the toolchain's own prebuilt
        # `Kex.URI.beam` over the one compiling this program produces, and
        # only the latter carries the `query/2` dispatcher clause that sends
        # a `Rodolfo.Context` receiver to Rodolfo's own `query`. With the
        # import, every `env.query(...)` here fails with `undef` at runtime
        # — see docs/kex-issues.md #27.
        let query = URI.Form.from([("token", roomToken), ("name", name)]).encode
        Response.HTML { body: "${Chat.Views.chat(name, "/chat?${query}")}" }
      else
        let error = if !attempted then "" else
          if validCredentials then "\"${name}\" is already in the room — try another name." else
            "Wrong password, or a name is needed."
          end
        end
        Response.HTML { body: "${Chat.Views.login(error)}" }
      end
    end

    ws "/chat" do |env, socket|
      let token = env.query("token").or("")
      let name = env.query("name").or("").trim
      if token != roomToken || name.empty?
        socket.close
      else
        match room.join(name, socket).try do
          Just(roster) => do
            room.broadcast(Chat.Protocol.systemLine("${name} joined"))
            room.broadcast(Chat.Protocol.rosterLine(roster))
            # `receiveMessage` blocks for as long as the peer stays connected
            # — an idle client sends nothing for minutes at a time, which is
            # the ordinary case for a chat room, not a timeout (kexhq/kex#381,
            # fixed; docs/kex-issues.md #28).
            #
            # A real disconnect still fails the receive rather than ever
            # handing back a `CloseMessage` — a dropped network, a closed
            # laptop lid — and leaving the loop on it runs the same cleanup a
            # clean close does. Skipping that cleanup would leave a phantom
            # entry in `Room` forever: the name stays "taken" until some later
            # `broadcast` happens to try this dead socket and prune it.
            loop do
              match socket.receiveMessage do
                Ok(Text(text)) => room.broadcast(Chat.Protocol.chatLine(name, text))
                Ok(CloseMessage(_, _)) => break
                Ok(_) => Void
                Error(_) => break
              end
            end
            let remaining = room.leave(name).try
            room.broadcast(Chat.Protocol.systemLine("${name} left"))
            room.broadcast(Chat.Protocol.rosterLine(remaining))
          end
          None => do
            socket.send(Text(Chat.Protocol.systemLine("\"${name}\" is already in this room — try another name."))).try
            socket.close
          end
        end
      end
    end
  end

  IO.printLine("Chat room on http://localhost:3000/ (room password: ${roomToken})")
  site.start(3000).try
end
