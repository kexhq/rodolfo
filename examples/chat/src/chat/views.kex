# Chat's two pages, compiled from `.ket` templates (`Kex.embed` +
# `Template.html`, kexhq/kex#171). Built as Rodolfo `html$`/`rawHTML$`
# literals for a while instead: `Template.scan`'s O(N^2) char-by-char scan
# (kexhq/kex#379, fixed) made a page this size time out, and then
# `Kex.embed`/`Template.html` from a non-entry module silently returned
# wrong output (kexhq/kex#385, fixed by kexhq/kex#386). Both are fixed now,
# so the pages are `.ket` files again, co-located with this module — path
# resolution is relative to the declaring file, not the program's entry
# file, as of #386.
#
# `login`/`chat` call `Template.html(Kex.embed(...))` inline rather than
# through a separate named binding (`let renderLogin = Template.html(...)`,
# called as `renderLogin(error)`) — that compiled clean and passed under
# `kex -R`, but `kex --compile` failed at the `erlc` link step with
# `undefined function 'Chat.Views.renderLogin'/1`, a same-module,
# unqualified reference to the bound value. Not the same bug #385 named
# (that was a *cross*-module, qualified call); found while re-verifying
# #386's fix for this file. No upstream issue filed yet.
#
# Named `Chat.Views`, not the bare `Views` every other example uses: `tey`
# resolves the workspace `rodolfo` dependency by pulling in every sibling
# example under `examples/*`, so a bare `module Views` here collides with
# `examples/library`'s own — "warning: shadowed module definition for
# Views" — and one of the two silently loses.
module Chat.Views

using JSON
using Rodolfo, only: [Safe, safe]

# The password-and-name form. `error` carries the reason a previous attempt
# didn't reach the chat page, if there was one; an empty string means none.
# `login.html.ket`'s own `<% if !error.empty? %>` decides whether the notice
# shows at all, and its `<%= error %>` HTML-escapes it same as any other
# hole.
login : String -> Safe
let login(error) = safe(Template.html(Kex.embed("login.html.ket"))(error))

# The chat page itself: a name already checked against the room password, so
# all it has to do is open the WebSocket at `socketPath` (already the
# encoded "/chat?token=...&name=..." this connection should use).
#
# `chat.html.ket` takes three params — `name`, `jsName`, `jsPath` — because a
# `<script>` isn't HTML: the two holes it opens (`myName`, `path`) have to be
# real JS string literals, not the HTML-escaped text `<%= %>` produces
# everywhere else on the page. `jsLiteral` builds those literals and the
# template embeds them raw with `<%== %>`; `name` further down stays a
# `<%= %>` hole, escaped as normal, since it renders as HTML there.
chat : String -> String -> Safe
let chat(name, socketPath) = safe(Template.html(Kex.embed("chat.html.ket"))(name, jsLiteral(name), jsLiteral(socketPath)))

# A JS string literal for a `<script>` hole: JSON, with the two characters
# that could end the element escaped the way JavaScript, not HTML, spells
# them — a `\u` escape reads back as the same character to every JS engine,
# and is inert to an HTML parser looking for `</script`.
#
# This is what makes `<%== %>`-ing the result into `chat.html.ket` safe. JSON
# is not JavaScript-in-HTML: `JSON.stringify` has no reason to touch `<`, so
# a display name of `</script><script>alert(1)//` — deliverable by link,
# since the name is nothing but a query parameter — comes back as a JSON
# string that closes this very element and opens an attacker's. Rewriting
# `<` and `>` as the `\uXXXX` escapes JavaScript reads back as the same
# characters keeps the literal a literal, whatever it carries.
jsLiteral : String -> String
let jsLiteral(value) = JSON.stringify(value).replace("<", "\\u003C").replace(">", "\\u003E")
