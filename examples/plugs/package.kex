# An example run as a workspace member: it depends on the Rodolfo package
# at the root of this checkout, not a published release.
package "plugs" do
  version("0.1.0")
  description("Rodolfo example: composable request/response plugs")
  kex(">= 0.4.0-beta.3")
  license("MIT")

  entrypoint("src/main.kex")

  command("test:browser", run: "tey test spec/browser/plugs.spec.kex", description: "Run the browser specs in a headless Chrome")
  command("test:watch", run: "SHAKESPEARE_WATCH=1 tey test spec/browser/plugs.spec.kex", description: "Run the browser specs in a visible Chrome, paced, to watch them")

  tey("rodolfo", workspace: true)

  group :browser do
    tey("shakespeare", path: "../../../shakespeare-kexmain")
  end
end
