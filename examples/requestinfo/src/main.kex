# Reusable route-handler wrapping without hidden global state.
using Rodolfo

let withRequestInfo(handler) do
  { |env|
    let result = handler(env)
    "${env.request.method} ${env.request.target.string}: ${result}"
  }
end

main do
  run do
    get "/" do |_|
      "Open /orders/42 to exercise a dynamic route."
    end

    get("/orders/:id", withRequestInfo(do |env|
      "Order ${env.param("id").try} is ready"
    end))
  end.try
end
