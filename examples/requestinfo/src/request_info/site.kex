# The requestinfo example's routes, apart from `main` so a browser spec can
# serve them on a port of its own.
module RequestInfo.Site

using Rodolfo

let withRequestInfo(handler) do
  do |env|
    let result = handler(env)
    "${env.request.method} ${env.request.target.source}: ${result}"
  end
end

site : Router
let site = Rodolfo.router do
  get "/" do
    "Open /orders/42 to exercise a dynamic route."
  end

  get("/orders/:id", withRequestInfo(do |env|
    "Order ${env.param("id").try} is ready"
  end))
end
