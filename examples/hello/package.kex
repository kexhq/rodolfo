# An example run as a workspace member: it depends on the Rodolfo package
# at the root of this checkout, not a published release.
package "hello" do
  version("0.1.0")
  description("Rodolfo example: dynamic parameters and request bodies")
  kex(">= 0.4.0-beta")
  license("MIT")

  entrypoint("src/main.kex")

  tey("rodolfo", workspace: true)
end
