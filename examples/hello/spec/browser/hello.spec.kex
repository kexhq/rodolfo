# The hello example in a real browser: plain-text pages, a dynamic segment,
# and a request body echoed back.
#
#   tey test:browser    # headless
#   tey test:watch      # a visible, paced browser
using Shakespeare

foul browserOptions() -> Shakespeare.Options = Shakespeare.Options {
  watch?: ENV.get("SHAKESPEARE_WATCH") == Just("1"),
  headless?: ENV.get("SHAKESPEARE_HEADLESS") == Just("1")
}

# `site` on a port of its own for one case, at the base URL `work` gets.
# No `.try` in this body: it would catch a failed assertion raised by `work`,
# and the case would pass.
foul served(site: Rodolfo.Router, work: String -> Any) -> Void do
  match site.background(0) do
    Ok(server) => do
      work("http://127.0.0.1:${Net.HTTP.Server.localAddress(server).port.value}")
      Net.HTTP.Server.stop(server)
      ()
    end
    Error(reason) => do
      assert(false, "the site could not be served: ${reason}")
      ()
    end
  end
end

describe("the hello example in a browser") do
  it("greets on the home page") do
    served(Hello.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/").try
        Shakespeare.expect(page.locator("body")).toHaveText("Rodolfo says hello!")
      end
    end
  end

  it("greets the name in the path") do
    served(Hello.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/hello/Ada").try
        Shakespeare.expect(page.locator("body")).toHaveText("Hello, Ada!")
      end
    end
  end

  it("echoes a body posted from the page") do
    served(Hello.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/").try
        let echoed = page.evaluate("fetch('/echo', { method: 'POST', body: 'ping' }).then(r => r.text())").try
        assert("${echoed}" == "ping", "echoed ${echoed}")
      end
    end
  end
end
