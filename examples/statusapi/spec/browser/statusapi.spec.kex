# The status API from a real browser: JSON as a page script fetches it, and
# a bad id answered with a 400.
#
#   tey test:browser    # headless
#   tey test:watch      # a visible, paced browser
using Shakespeare

foul browserOptions() -> Shakespeare.Options = Shakespeare.Options {
  watch?: ENV.get("SHAKESPEARE_WATCH") == Just("1"),
  headless?: ENV.get("SHAKESPEARE_HEADLESS") == Just("1")
}

# `site` on a port of its own for one case, at the base URL `work` gets.
# No `.try` in this body: it would catch a failed assertion raised by `work`,
# and the case would pass.
foul served(site: Rodolfo.Router, work: String -> Any) -> Void do
  match site.background(0) do
    Ok(server) => do
      work("http://127.0.0.1:${Net.HTTP.Server.localAddress(server).port.value}")
      Net.HTTP.Server.stop(server)
      ()
    end
    Error(reason) => do
      assert(false, "the site could not be served: ${reason}")
      ()
    end
  end
end

# A page script's fetch of `path`, as "<status> <body>".
foul fetched(page: Shakespeare.Page, path: String) -> String do
  let answer = page.evaluate("fetch('${path}').then(async r => r.status + ' ' + await r.text())")
  "${answer.or("the fetch failed")}"
end

describe("the status API in a browser") do
  it("reports its health") do
    served(StatusApi.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/health").try
        Shakespeare.expect(page.locator("body")).toContainText("\"status\":\"ok\"")
      end
    end
  end

  it("answers a book by id") do
    served(StatusApi.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/health").try
        let answer = fetched(page, "/api/books/7")
        assert(answer.startsWith?("200 "), answer)
        assert(answer.contains?("\"id\":7"), answer)
        assert(answer.contains?("Programming Kex"), answer)
      end
    end
  end

  it("refuses an id that is not a number") do
    served(StatusApi.Site.site) do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/health").try
        let answer = fetched(page, "/api/books/seven")
        assert(answer.startsWith?("400 "), answer)
        assert(answer.contains?("\"error\""), answer)
      end
    end
  end
end
