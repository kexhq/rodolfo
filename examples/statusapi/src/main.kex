using JSON
using Rodolfo

main do
  let apiRouter = Rodolfo.router do
    get "/health" do |_|
      Response.JSON {
        body: JSON.stringify({ "status": "ok", "service": "catalog" })
      }
    end

    get "/api/books/:id" do |env|
      let id = Integer.parse(env.param("id").try).try
      Response.JSON {
        body: JSON.stringify({
          "id": id,
          "title": "Programming Kex",
          "available": true
        })
      }
      rescue |e|
        Response.JSON {
          status: 400,
          body: JSON.stringify({ "error": e.message })
        }
    end

    post "/api/echo" do |env|
      env.request.body.to(String).try
    end
  end

  apiRouter.start(4000).try
end
