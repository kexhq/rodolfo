# An example run as a workspace member: it depends on the Rodolfo package
# at the root of this checkout, not a published release.
package "website" do
  version("0.1.0")
  description("Rodolfo example: server-rendered HTML responses and static files")
  kex(">= 0.4.0-beta.4")
  license("MIT")

  entrypoint("src/main.kex")

  command("test:browser", run: "tey test spec/browser/website.spec.kex", description: "Run the browser specs in a headless Chrome")
  command("test:watch", run: "SHAKESPEARE_WATCH=1 tey test spec/browser/website.spec.kex", description: "Run the browser specs in a visible Chrome, paced, to watch them")

  tey("rodolfo", workspace: true)

  group :browser do
    tey("shakespeare", git: "https://github.com/kexhq/shakespeare", ref: "af848daa65df65d214b5e95b9206fa86339e83a5")
  end
end
