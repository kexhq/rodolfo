# The website in a real browser: the pages render, a link navigates, and the
# stylesheet `publicFolder` serves is applied.
#
#   tey test:browser    # headless
#   tey test:watch      # a visible, paced browser
using Shakespeare

foul browserOptions() -> Shakespeare.Options = Shakespeare.Options {
  watch?: ENV.get("SHAKESPEARE_WATCH") == Just("1"),
  headless?: ENV.get("SHAKESPEARE_HEADLESS") == Just("1")
}

# The site on a port of its own for one case, at the base URL `work` gets.
# No `.try` in this body: it would catch a failed assertion raised by `work`,
# and the case would pass.
foul served(work: String -> Any) -> Void do
  match Website.Site.site.background(0) do
    Ok(server) => do
      work("http://127.0.0.1:${Net.HTTP.Server.localAddress(server).port.value}")
      Net.HTTP.Server.stop(server)
      ()
    end
    Error(reason) => do
      assert(false, "the site could not be served: ${reason}")
      ()
    end
  end
end

describe("the website in a browser") do
  it("renders the home page") do
    served do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/").try
        assert(page.title().try == "Rodolfo Books")
        Shakespeare.expect(page.locator("h1")).toHaveText("Independent books")
      end
    end
  end

  it("follows the nav link home from an author page") do
    served do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/authors/ada").try
        Shakespeare.expect(page.locator("h1")).toHaveText("ada")
        page.getByRole("link", "Home").click().try
        Shakespeare.expect(page.locator("h1")).toHaveText("Independent books")
      end
    end
  end

  it("applies the stylesheet from public/") do
    served do |base|
      Shakespeare.withPage(browserOptions()) do |page|
        page.goto("${base}/").try
        let font = page.evaluate("getComputedStyle(document.body).fontFamily").try
        assert("${font}".contains?("Georgia"), "body font is ${font}")
      end
    end
  end
end
